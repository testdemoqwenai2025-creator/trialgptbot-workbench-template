# Environment variables — copy this file to `.env` and fill in as needed.
# (Use .env, not .env.local — Prisma reads .env by default; Next.js reads both.)

# Database (SQLite default — change to postgres://... for production)
# Note: the path is relative to the prisma/ directory (where schema.prisma lives),
# so file:../db/custom.db resolves to <repo-root>/db/custom.db.
DATABASE_URL="file:../db/custom.db"

# NextAuth (required if you wire authentication)
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL="http://localhost:3000"

# AI SDK (declared in package.json, ready to wire)
# Z_AI_API_KEY="your-api-key"

# App
NODE_ENV=development
PORT=3000
