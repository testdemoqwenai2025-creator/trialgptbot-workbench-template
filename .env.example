# Environment variables — copy to .env.local and fill in

# Database (SQLite default — change to postgres:// for production)
DATABASE_URL="file:./db/custom.db"

# NextAuth (required if you wire authentication)
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL="http://localhost:3000"

# AI SDK (declared in package.json, ready to wire)
# Z_AI_API_KEY="your-api-key"

# App
NODE_ENV=development
PORT=3000
